# copiar a .env.nube y completar con los datos que da el proveedor. .env.nube no se sube al repositorio
# conexion con el rol propietario de la base en la nube
PGHOST=ep-ejemplo-123456.sa-east-1.aws.neon.tech
PGPORT=5432
PGDATABASE=bodegas
PGUSER=bodega_owner
PGPASSWORD=cambiar_clave_owner
PGSSLMODE=require

# claves que se asignan a bodega_app y bodega_lectura al aplicar las migraciones
APP_DB_PASSWORD=cambiar_clave_app
LECTURA_DB_PASSWORD=cambiar_clave_lectura
