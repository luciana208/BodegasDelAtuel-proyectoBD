# copiar este archivo a .env y cambiar las claves
POSTGRES_DB=bodegas
POSTGRES_USER=bodega_owner
POSTGRES_PASSWORD=cambiar_clave_owner
APP_DB_PASSWORD=cambiar_clave_app
LECTURA_DB_PASSWORD=cambiar_clave_lectura
DB_PORT=5432

# api: puerto local y origenes permitidos por cors, separados por comas
API_PORT=8000
CORS_ORIGINS=http://localhost:8080

# front: puerto local y url con la que el navegador llega a la api
FRONT_PORT=8080
API_URL=http://localhost:8000

# semilla de la carga masiva y fecha base opcional (aaaa-mm-dd, vacia es hoy)
SEMILLA=2026
FECHA_BASE=
